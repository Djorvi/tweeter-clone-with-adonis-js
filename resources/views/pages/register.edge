<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Créer votre compte</title>
    <style>
        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
            color: #333;
        }
        
        h1 {
            font-size: 24px;
            font-weight: bold;
            margin-bottom: 30px;
        }
        
        .form-group {
            margin-bottom: 20px;
        }
        
        label {
            display: block;
            font-weight: bold;
            margin-bottom: 8px;
            font-size: 14px;
        }
        
        input[type="text"],
        input[type="email"],
        input[type="tel"],
        select {
            width: 100%;
            padding: 12px;
            border: 1px solid #ddd;
            border-radius: 4px;
            font-size: 16px;
            box-sizing: border-box;
        }
        
        .email-option {
            color: #1d9bf0;
            font-weight: bold;
            margin: 15px 0;
            cursor: pointer;
        }
        
        .date-section {
            margin-top: 30px;
        }
        
        .date-title {
            font-weight: bold;
            margin-bottom: 8px;
        }
        
        .date-description {
            color: #666;
            font-size: 14px;
            margin-bottom: 20px;
        }
        
        .date-selectors {
            display: flex;
            gap: 10px;
        }
        
        .date-selector {
            flex: 1;
        }
        
        .next-button {
            background-color: #000;
            color: white;
            border: none;
            padding: 12px 20px;
            border-radius: 20px;
            font-weight: bold;
            font-size: 16px;
            cursor: pointer;
            margin-top: 30px;
            width: 120px;
        }
        
        .next-button:hover {
            background-color: #333;
        }
    </style>
</head>




<body>
    <h1>Créer votre compte</h1>

    <form action="/register" method="POST">

        {{csrfField()}}
        
        <label >Nom et prénom</label>
        <input type="text"  class="form-group" name="fullName">


        <label >Email</label>
        <input  class="form-group" type="email"  name="email">

        <label>password</label>
        <input  class="form-group" type="password" name="password">

        <button type="submit" class="next-button"> Envoyer</button>
  
    </form>
    
    <div class="date-section">
        <div class="date-title">Date de naissance</div>
        <div class="date-description">
            Cette information ne sera pas affichée publiquement. Confirmez votre âge, même si ce compte est pour une entreprise, un animal de compagnie ou autre chose.
        </div>
        
        <div class="date-selectors">
            <div class="date-selector">
                <label for="month">Mois</label>
                <select id="month" name="month">
                    <option value="">Mois</option>
                    <option value="01">Janvier</option>
                    <option value="02">Février</option>
                    <option value="03">Mars</option>
                    <option value="04">Avril</option>
                    <option value="05">Mai</option>
                    <option value="06">Juin</option>
                    <option value="07">Juillet</option>
                    <option value="08">Août</option>
                    <option value="09">Septembre</option>
                    <option value="10">Octobre</option>
                    <option value="11">Novembre</option>
                    <option value="12">Décembre</option>
                </select>
            </div>
            
            <div class="date-selector">
                <label for="day">Jour</label>
                <select id="day" name="day">
                    <option value="">Jour</option>
                    <!-- Générer les jours 1-31 -->
                    <script>
                        for (let i = 1; i <= 31; i++) {
                            document.write(`<option value="${i < 10 ? '0' + i : i}">${i}</option>`);
                        }
                    </script>
                </select>
            </div>
            
            <div class="date-selector">
                <label for="year">Année</label>
                <select id="year" name="year">
                    <option value="">Année</option>
                    <!-- Générer les années (ex: 1900-2025) -->
                    <script>
                        const currentYear = new Date().getFullYear();
                        for (let i = currentYear; i >= 1900; i--) {
                            document.write(`<option value="${i}">${i}</option>`);
                        }
                    </script>
                </select>
            </div>
        </div>
    </div>
    
    


</body>
</html>