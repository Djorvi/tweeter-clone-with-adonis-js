<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" rel="stylesheet">
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css"/>
    <title>
      AdonisJS - A fully featured web framework for Node.js
    </title>
    @vite(['resources/css/app.css', 'resources/js/app.js'])
    @stack('dumper')
  </head>
  <body>    
    
    <div class="Block-flex"> 
        <!-- Sidebar -->
        <div class="icons-x">
            <span class="Home-Home1"><img src="public/images/téléchargement.png" class="icone-menu-X"></a></span>
            <nav class="menu-bar">
                <span class="Home-Home"><a href="#"><i class='bx bx-home-alt-2' style='color:#f1eeee'></i></i></a>Home</span>
                <li><a href="#"><i class='bx bx-search' style='color:#d9d9d9ee'></i></a>Explore</li>
                <li><a href="#"><i class='bx bx-bell' style='color:#d9d9d9ee'></i></a>Notifications</li>
                <li><a href="#"><i class='bx bx-envelope' style='color:#d9d9d9ee'></i></a>Messages</li>
                <li><a href="#"><i class='bx bxl-blender' style='color:#d9d9d9ee'></i></a>Grok</li>
                <li><a href="#"><i class='bx bx-bookmark' style='color:#d9d9d9ee'></i></a>Communities</li>
                <li><a href="#"><i class='bx bx-badge-check' style='color:#d9d9d9ee'></i></a></a>Premiun</li>
                <li><a href="#"><i class='bx bxs-bolt' style='color:#d9d9d9ee'></i></a>Verified Orgs</li>
                <li><a href="#"><i class='bx bx-user' style='color:#d9d9d9ee'></i></a>Profilee</li>
                <li><a href="#"><i class='bx bx-cog' style='color:#d9d9d9ee'></i></a>More</li>
            </nav>

            <div class="Button">
                <button class="disabled">
                    Post 
                </button>
            </div>

            <div class="profile">
                <img src="public/images/IMG_0541.JPG" alt="Profile">
                <div class="obed-Mbora">
                    <p><a href="https://x.com/home">Obed Mbora<i class='bx bx-lock' style='color:#ffff'></i></a></p>
                    <p class="ObedMbora">@ObedMbora</p>  
                </div>
              
            </div>
    
        </div>
        
    

        <!-- Fil d'actualité -->
        <div class="main-content">
            <div class="Deux-Button">
                <div class="Deux-Button-flex">
                    <div class="Bnt1">
                        <P>
                            For yo
                        </P>
                    </div>


                    <div class="Bnt1">
                        <P>
                            Following
                        </P>
                    </div>
                </div>
            </div>

            <div class="Cherche">
                <div class="profile-img">
                    <img src="public/images/IMG_0541.JPG" class="taille">
                    <div class="search-bos">
                        <input type="text" placeholder="What is happening?!">
                        
                        <div class="icone-Notifications">
                            <div class="icnon-flex">
                                <a href="#"><i class='bx bx-image-alt' style='color:#0289d7'></i></a>
                                <a href="#"><i class='bx bx-calendar-event'  style='color:#0289d7'></i></a>
                                <a href="#"><i class='bx bxs-file-gif' style='color:#0289d7'></i></a>
                                <a href="#"><i class='bx bx-bookmarks' style='color:#0289d7'></i></a>
                                <a href="#"><box-icon name='smile'  style='color:#0289d7'></box-icon></a>
                            </div>

                            <button class="button3">
                                Post
                            </button>

                        </div>
                    </div> 
                </div>
            </div>

            <div class="actualite">
                <div class="tweet">
                    <!-- Profil utilisateur -->
                    <div class="tweet-header">
                        <img src="public/images/IMG_0541.JPG" alt="Photo de profil" class="profil-pic">
                        <div class="user-info">
                            <span class="username">Constant Mutamba</span>
                            <span class="verified"><i class='bx bxs-badge-check' style='color:#0084ea' ></i></span>
                            <span class="handle">@ConstantMutamba</span>
                            <div class="point">
                                <a href="">
                                    <div class="point">
                                        <i class='bx bx-dots-horizontal-rounded' style='color:#ffffff'  ></i>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>
            
                    <!-- Contenu du tweet -->
                    <p class="tweet-text">
                        #RDC Réouverture de l'École Nationale de Criminologie, ce samedi 15 mars, après sa fermeture en 1987.
                        3500 jeunes candidats inspecteurs judiciaires ont passé le concours...
                    </p>
            
                    <!-- Image du tweet -->
                    <div class="tweet-image">
                        <img src="public/images/IMG_0541.JPG" alt="Image du post">
                    </div>
            
                    <!-- Infos et actions -->
                    <div class="tweet-footer">
                        <span class="icon"><i class='bx bx-message-rounded'></i> 269</span>
                        <span class="icon"><i class='bx bx-repeat'></i> 250</span>
                        <span class="icon"><i class='bx bx-heart'></i>  1.5k</span>
                        <span class="icon"><i class='bx bx-upload'></i> 104k</span>
                    </div>
                    
                </div>
            </div>


            <div class="actualite">
                <div class="tweet">
