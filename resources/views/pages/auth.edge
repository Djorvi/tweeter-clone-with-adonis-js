<!-- Fil d'actualité -->
<div class="main-content">
  <div class="tabs">
    <button class="tab active" data-tab="foryou"><a href="#">For You</a></button>
    <button class="tab" data-tab="following"><a href="#">Following</a></button>
    <div class="tab-indicator"></div>
  </div>

  <!-- Formulaire de tweet -->
  <form action="/tweets" method="POST">
    @csrf
    <div class="Cherche">
      <div class="profile-img">
        <a href="resources/views/pages/profile.edge"><img src="/images/IMG_3811.JPG" class="taille" /></a>
        <div class="search-bos">
          <input type="text" name="content" placeholder="What is happening?!" required>
          <div class="icone-Notifications">
            <div class="icnon-flex">
              <a href="#"><i class='bx bx-image-alt' style='color:#0289d7'></i></a>
              <a href="#"><i class='bx bx-calendar-event' style='color:#0289d7'></i></a>
              <a href="#"><i class='bx bxs-file-gif' style='color:#0289d7'></i></a>
              <a href="#"><i class='bx bx-bookmarks' style='color:#0289d7'></i></a>
              <a href="#"><i class='bx bx-smile' style='color:#0289d7'></i></a>
            </div>
            <button type="submit" class="button3">Post</button>
          </div>
        </div>
      </div>
    </div>
  </form>

  <!-- Affichage des tweets -->
  @each(tweet in tweets)
    <div class="actualite">
      <div class="tweet">
        <!-- Header -->
        <div class="tweet-header">
          <img src="/images/IMG_3811.JPG" class="taille">
          <div class="user-info">
            <span class="username">{{ tweet.user?.fullName ?? 'Utilisateur inconnu' }}</span>
            <span class="verified"><i class='bx bxs-badge-check' style='color:#0084ea'></i></span>
            <span class="handle">@{{ tweet.user?.email ?? 'email inconnu' }}</span>
            <div class="point">
              <a href="#">
                <i class='bx bx-dots-horizontal-rounded' style='color:#ffffff'></i>
              </a>
            </div>
          </div>
        </div>

        <!-- Contenu du tweet -->
        <p class="tweet-text">{{ tweet.content }}</p>

        <!-- Média (optionnel) -->
        <div class="tweet-video">
          <video controls>
            <source src="/images/Vodeo1.mp4" type="video/mp4">
            Votre navigateur ne supporte pas la lecture de vidéos.
          </video>
        </div>

        <!-- Actions -->
        <div class="tweet-footer">
          <span class="icon"><i class='bx bx-message-rounded'></i> 269</span>
          <span class="icon"><i class='bx bx-repeat'></i> 250</span>
          <span class="icon"><i class='bx bx-heart'></i> 1.5k</span>
          <span class="icon"><i class='bx bx-upload'></i> 104k</span>
        </div>
      </div>
    </div>
  @endeach
</div>
