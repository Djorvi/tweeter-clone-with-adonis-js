@layout('layouts/main')

@section('content')
<div class="container mx-auto p-4">
  <div class="bg-white p-4 rounded-lg shadow">
    <div class="flex items-center">
      <img src="{{ user.avatar }}" alt="{{ user.username }}" class="w-16 h-16 rounded-full">
      <div class="ml-4">
        <p class="text-xl font-bold">{{ user.username }}</p>
        <p class="text-gray-500">{{ user.handle }}</p>
      </div>
    </div>
    <p class="mt-4">{{ user.bio }}</p>
  </div>
  <h2 class="text-xl font-bold mt-8">Tweets</h2>
  @each(tweet in user.tweets)
    <div class="bg-white p-4 rounded-lg shadow mt-4">
      <p>{{ tweet.content }}</p>
      <div class="flex mt-4 space-x-4">
        <button class="flex items-center text-gray-500 hover:text-blue-500 transition-colors duration-200">
          <span class="mr-1">❤️</span> {{ tweet.likes }}
        </button>
        <button class="flex items-center text-gray-500 hover:text-green-500 transition-colors duration-200">
          <span class="mr-1">🔁</span> {{ tweet.retweets }}
        </button>
        <button class="flex items-center text-gray-500 hover:text-purple-500 transition-colors duration-200">
          <span class="mr-1">💬</span> {{ tweet.comments }}
        </button>
      </div>
    </div>
  @endeach
</div>
@endsection