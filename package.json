{
  "name": "adonis-projet-test",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "start": "node build/bin/server.js",
    "build": "node ace build && cp -r resources/views build/resources/views",
    "dev": "node ace serve --hmr",
    "test": "node ace test",
    "lint": "eslint . --ext .ts,.js --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf build",
    "rebuild": "npm run clean && npm run build",
    "start:dev": "node ace serve --watch",
    "migrate": "node ace migration:run --force",
    "migrate:rollback": "node ace migration:rollback",
    "migrate:refresh": "node ace migration:refresh --force",
    "migrate:reset": "node ace migration:reset --force",
    "seed": "node ace db:seed",
    "healthcheck": "node ace health:check",
    "production": "cross-env NODE_ENV=production npm run rebuild && cd build && npm ci --omit=dev && node bin/server.js",
    "check": "npm run lint && npm run typecheck && npm run test",
    "full-install": "npm install && npm run build"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#mails/*": "./app/mails/*.js",
    "#services/*": "./app/services/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#events/*": "./app/events/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^7.8.2",
    "@adonisjs/eslint-config": "^2.0.0",
    "@adonisjs/prettier-config": "^1.4.0",
    "@adonisjs/tsconfig": "^1.4.0",
    "@japa/assert": "^4.0.1",
    "@japa/plugin-adonisjs": "^4.0.0",
    "@japa/runner": "^4.2.0",
    "@swc/core": "1.10.7",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.13.2",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "eslint": "^9.20.1",
    "hot-hook": "^0.4.0",
    "pino-pretty": "^13.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.5.0",
    "tailwindcss": "^4.1.3",
    "ts-node-maintained": "^10.9.5",
    "typescript": "~5.7",
    "vite": "^6.1.0"
  },
  "dependencies": {
    "@adonisjs/auth": "^9.4.0",
    "@adonisjs/core": "^6.17.2",
    "@adonisjs/lucid": "^21.6.1",
    "@adonisjs/session": "^7.5.1",
    "@adonisjs/shield": "^8.1.2",
    "@adonisjs/static": "^1.1.1",
    "@adonisjs/vite": "^4.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@vinejs/vine": "^3.0.0",
    "edge.js": "^6.2.1",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.5.0",
    "pg": "^8.15.6",
    "reflect-metadata": "^0.2.2"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "prettier": "@adonisjs/prettier-config",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "packageManager": "npm@9.8.1"
}
